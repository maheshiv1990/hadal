# Production settings for hadalspace.com. Copy to .env on the server, or have
# your secrets manager write these values there (CASA 6.7.1). Never commit .env.
#
#   scripts/letsencrypt-init.sh you@example.com --staging   # dry run first
#   scripts/letsencrypt-init.sh you@example.com             # real certificate
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Served as https://hadalspace.com; www.hadalspace.com is on the same
# certificate. Both need DNS records pointing at this server.
DOMAIN=hadalspace.com
# certbot --cert-name (the folder under /etc/letsencrypt/live/).
CERT_NAME=hadalspace.com

POSTGRES_USER=hadal
POSTGRES_PASSWORD=
POSTGRES_DB=hadal

# Google OAuth client. Register https://hadalspace.com/api/auth/callback as
# an authorized redirect URI (docker-compose.prod.yml sets it from DOMAIN).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256 key for Gmail refresh tokens and imported mail at rest
# (openssl rand -base64 32). Keep it in the secrets manager; never rotate it
# without a re-encryption plan.
DATA_ENCRYPTION_KEY=

SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=43200
RUST_LOG=info
