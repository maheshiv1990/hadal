{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/casa_check.py\" lint --hook",
            "timeout": 30,
            "statusMessage": "CASA rule check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/claude-stop-gate.sh\"",
            "timeout": 600,
            "statusMessage": "CASA gate (scripts/verify.sh quick)"
          }
        ]
      }
    ]
  }
}
