# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=hadal
# Required. Left empty on purpose: docker compose refuses to start until it is set.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=hadal

# Google OAuth client, type "Web application", from
# https://console.cloud.google.com/apis/credentials. Register exactly this
# redirect URI there. Outside localhost it must be https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://localhost:8000/api/auth/callback

# AES-256 key that encrypts linked Gmail refresh tokens and imported mail at
# rest. Required. Generate with: openssl rand -base64 32
# Losing or changing it makes stored mail unreadable (relink and re-import).
DATA_ENCRYPTION_KEY=

# Session lifetime (seconds): idle timeout and absolute cap (max 86400).
SESSION_IDLE_SECS=1800
SESSION_ABSOLUTE_SECS=43200

# Host port nginx is published on: the app is https://localhost:8000, and
# plain HTTP to it redirects to HTTPS. Certificates: scripts/dev-certs.sh.
HTTPS_PORT=8000
# HSTS lifetime in seconds. Local default is 300 so localhost isn't pinned to
# HTTPS for long; leave unset in production (the image default is 2 years).
# HSTS_MAX_AGE=300
RUST_LOG=info

# Used by `cargo run` in backend/ for local dev (DB from `docker compose up db`).
# Postgres requires TLS; sqlx negotiates it by default on localhost.
DATABASE_URL=postgres://hadal:${POSTGRES_PASSWORD}@localhost:5432/hadal

# Email + password accounts. Off: Hadal is Google-only and the register,
# password-login and password-change endpoints don't exist.
PASSWORD_AUTH_ENABLED=false

# Gmail push notifications: new mail is synced as soon as it arrives instead
# of at the next import. Off unless all three are set. Needs, in Google Cloud:
#   1. a Pub/Sub topic, with gmail-api-push@system.gserviceaccount.com allowed
#      to publish to it (Pub/Sub Publisher);
#   2. a push subscription to https://<your domain>/api/gmail/push with
#      authentication on, signing as a service account of yours, audience =
#      that same URL;
#   3. the Gmail API enabled in the project of the OAuth client.
# Pub/Sub can't reach localhost, so leave these empty for local development.
# GMAIL_PUSH_TOPIC=projects/<project>/topics/<topic>
# GMAIL_PUSH_AUDIENCE=https://hadalspace.com/api/gmail/push
# GMAIL_PUSH_SERVICE_ACCOUNT=<name>@<project>.iam.gserviceaccount.com
# Only mailboxes of users who signed in within this many days are watched.
# GMAIL_PUSH_ACTIVE_DAYS=7
