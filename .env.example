# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=hadal
# Required. Left empty on purpose: docker compose refuses to start until it is set.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=hadal

# Host port nginx is published on.
HTTP_PORT=8000
RUST_LOG=info

# Used by `cargo run` in backend/ for local dev (DB from `docker compose up db`).
DATABASE_URL=postgres://hadal:${POSTGRES_PASSWORD}@localhost:5432/hadal
