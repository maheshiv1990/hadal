# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=hadal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hadal

# Host port nginx is published on.
HTTP_PORT=8000
RUST_LOG=info

# Used by `cargo run` in backend/ for local dev (DB from `docker compose up db`).
DATABASE_URL=postgres://hadal:change-me@localhost:5432/hadal
